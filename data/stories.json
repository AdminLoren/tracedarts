    {
      "id": "melody-meant-for-another",
      "title": "Melody Meant for Another",
      "series": "The Happy Ever Party: Children of the Authors",
      "tagline": "The origin of how Fumio got the babes",
      "pairing": "Fumio × Fumiko",
      "status": "Ongoing",
      "summary": "The origin of how Fumio got the babes",
      "synopsis": [
        "Fumio Hasashi has admired Nijigasaki's Fumiko Sakura from a distance for years. One quiet afternoon by the river, he finally gets his chance to talk to her, though not in the way he ever imagined."
      ],
      "introScene": {
        "image": "assets/images/stories/melody-meant-for-another/bg_intro.jpg",
