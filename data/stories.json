              "#241a30",
              "#4a3a5a"
            ],
            "setting": "The Student Council office"
          },
          "music": {
            "file": "lore/melody_chapter3A.mp3",
            "title": "Collector (Fishdom H2O)",
            "cues": [
              {
                "text": "...Euh?",
                "action": "stop"
              },
              {
                "text": "approach the door past her",
                "action": "play",
                "file": "lore/melody_chapter3AB.mp3",
                "title": "TO BE ASSIGNED",
                "fadeIn": 2
              },
              {
                "text": "dance studio...",
                "action": "play",
                "file": "lore/melody_chapter3B.mp3",
                "title": "Karin’s Bond Theme (LL!! SIFAS)",
                "fadeIn": 2,
                "scene": {
                  "image": "assets/images/stories/melody-meant-for-another/bg_chapter3B.jpg",
                  "colors": [
                    "#1a2438",
                    "#4a5a7a"
                  ],
                  "setting": "Nijigasaki's dance studio"
                }
              },
              {
                "text": "Standing on the other side was a stern-looking Shioriko",
                "action": "stop"
              },
              {
                "text": "Karin moved aside, utterly confused",
                "action": "play",
                "file": "lore/melody_chapter3C.mp3",
                "title": "Ah-Wa-Wa-Wa! (Super Mario Galaxy 2)",
                "fadeIn": 2
              },
              {
                "text": "confessed her love, Mifune-san",
                "action": "stop"
              },
              {
                "text": "sure everyone understands, right",
                "action": "play",
                "file": "lore/melody_chapter3D.mp3",
                "title": "Yoshiko’s Bond Theme (LL!! SIFAS)",
                "fadeIn": 2
              },
              {
                "text": "The trio of friends walked along",
                "action": "play",
                "file": "lore/melody_chapter3E.mp3",
                "title": "A Spooky Sprint (Super Mario Galaxy)",
                "fadeIn": 2,
                "scene": {
                  "image": "assets/images/stories/melody-meant-for-another/bg_chapter3C.jpg",
                  "colors": [
